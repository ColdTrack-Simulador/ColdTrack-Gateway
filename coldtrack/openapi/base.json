          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      }
    },
    "/api/simulator/readings": {
      "post": {
        "operationId": "simulateReading",
        "tags": [
          "Telemetría"
        ],
        "summary": "Simular una lectura",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "description": "El propietario indica deviceId. El modo demo usa SIM-001.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "deviceId": {
                    "type": "string",
                    "example": "CT-001"
                  },
                  "tempInterior": {
                    "type": "number",
                    "example": -18
                  },
                  "tempCondensador": {
                    "type": "number",
                    "example": 37
                  },
                  "tempSuccion": {
                    "type": "number",
                    "example": -22
                  },
                  "presionAlta": {
                    "type": "number",
                    "example": 65
                  },
                  "presionBaja": {
                    "type": "number",
                    "example": 28
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lectura sin almacenar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Telemetry"
                }
              }
            }
          },
          "201": {
            "description": "Lectura almacenada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Telemetry"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "415": {
            "$ref": "#/components/responses/415"
          }
        }
      }
    },
