{
  "openapi": "3.0.3",
  "info": {
    "title": "ColdTrack API",
    "version": "1.3.0",
    "description": "Iniciá sesión desde Cuenta para usar las rutas de propietario o técnico. Swagger conserva la cookie en este dominio. Para el gateway y el correo, usá la credencial Bearer correspondiente."
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "tags": [
          "Sistema"
        ],
        "summary": "Consultar salud de la API",
        "security": [],
        "responses": {
          "200": {
            "description": "Estado del servicio",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/session": {
      "get": {
        "operationId": "getSession",
        "tags": [
          "Cuenta"
        ],
        "summary": "Consultar la sesión",
        "security": [],
        "responses": {
          "200": {
            "description": "Estado de sesión",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "startSession",
        "tags": [
          "Cuenta"
        ],
        "summary": "Iniciar sesión",
        "security": [],
        "description": "Para cuentas registradas, usar el correo en username. Swagger reutiliza la cookie del mismo dominio.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "example": "propietario@example.test"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "maxLength": 256
                  }
                },
                "required": [
                  "username",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Sesión iniciada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "429": {
            "$ref": "#/components/responses/429"
          }
        }
      },
      "delete": {
        "operationId": "endSession",
        "tags": [
          "Cuenta"
        ],
        "summary": "Cerrar sesión",
        "security": [],
        "responses": {
          "200": {
            "description": "Estado de sesión",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Session"
                }
              }
            }
          }
        }
      }
    },
    "/api/registration": {
      "post": {
        "operationId": "registerAccount",
        "tags": [
          "Cuenta"
        ],
        "summary": "Solicitar código de registro",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "propietario@example.test"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 100,
                    "example": "Nombre de prueba"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "minLength": 12,
                    "maxLength": 256,
                    "example": "clave-larga-de-prueba"
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "owner",
                      "technician"
                    ],
                    "default": "owner"
                  },
                  "phone": {
                    "type": "string",
                    "maxLength": 40
                  }
                },
                "required": [
                  "email",
                  "name",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Solicitud aceptada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Registration"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      }
    },
    "/api/registration/verify": {
      "post": {
        "operationId": "verifyRegistration",
        "tags": [
          "Cuenta"
        ],
        "summary": "Verificar código de registro",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "propietario@example.test"
                  },
                  "registrationId": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^[0-9]{6}$",
                    "example": "123456"
                  }
                },
                "required": [
                  "email",
                  "registrationId",
                  "code"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Correo verificado"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      }
    },
    "/api/devices": {
      "get": {
        "operationId": "listDevices",
        "tags": [
          "Equipos"
        ],
        "summary": "Listar equipos visibles",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Equipos",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "devices": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Device"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          }
        }
      },
      "post": {
        "operationId": "registerDevice",
        "tags": [
          "Equipos"
        ],
        "summary": "Registrar equipo como propietario",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "maxLength": 100,
                    "example": "Nombre de prueba"
                  }
                },
                "required": [
                  "name"
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Equipo creado; gatewayToken se entrega una vez",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceCreated"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          }
        }
      }
    },
    "/api/devices/{device_id}/policy": {
      "get": {
        "operationId": "getCapturePolicy",
        "tags": [
          "Equipos"
        ],
        "summary": "Consultar política de captura",
        "security": [
          {
            "SessionCookie": []
          },
          {
            "Bearer": []
          }
        ],
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "CT-001"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Política y estado efectivo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CapturePolicyStatus"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      },
      "patch": {
        "operationId": "updateCapturePolicy",
        "tags": [
          "Equipos"
        ],
        "summary": "Cambiar sensores, horarios y umbrales",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "CT-001"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PolicyChanges"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Política actualizada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Policy"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      }
    },
    "/api/devices/{device_id}/alerts": {
      "get": {
        "operationId": "listDeviceAlerts",
        "tags": [
          "Equipos"
        ],
        "summary": "Consultar alertas del equipo",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "CT-001"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Alertas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Alert"
                      }
                    }
                  },
                  "required": [
                    "items"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      }
    },
    "/api/telemetry": {
      "get": {
        "operationId": "listTelemetry",
        "tags": [
          "Telemetría"
        ],
        "summary": "Consultar historial de telemetría",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "deviceId",
            "in": "query",
            "schema": {
              "type": "string",
              "example": "CT-001"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 50,
              "description": "La respuesta se limita a 500 lecturas."
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lecturas visibles",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Telemetry"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          }
        }
      },
      "post": {
        "operationId": "receiveTelemetry",
        "tags": [
          "Telemetría"
        ],
        "summary": "Enviar lectura desde el gateway",
        "security": [
          {
            "Bearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TelemetryInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Lectura sin almacenar",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TelemetryReceipt"
                }
              }
            }
          },
          "201": {
            "description": "Lectura almacenada",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TelemetryReceipt"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "415": {
            "$ref": "#/components/responses/415"
          }
        }
      }
    },
    "/api/telemetry/latest/{device_id}": {
      "get": {
        "operationId": "getLatestTelemetry",
