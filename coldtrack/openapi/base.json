    "/api/mail/claim": {
      "post": {
        "operationId": "claimMail",
        "tags": [
          "Correo"
        ],
        "summary": "Reservar siguiente correo disponible",
        "security": [
          {
            "Bearer": []
          }
        ],
        "description": "Usar la credencial de correo. La reserva vence a los dos minutos.",
        "responses": {
          "200": {
            "description": "Correo reservado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Mail"
                }
              }
            }
          },
          "204": {
            "description": "Cola sin mensajes disponibles"
          },
          "401": {
            "$ref": "#/components/responses/401"
          }
        }
      }
    },
    "/api/mail/{mail_id}/ack": {
      "post": {
        "operationId": "acknowledgeMail",
        "tags": [
          "Correo"
        ],
        "summary": "Confirmar resultado de entrega",
        "security": [
          {
            "Bearer": []
          }
        ],
        "description": "Usar la credencial de correo y la reserva recibida en claim.",
        "parameters": [
          {
            "name": "mail_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "minimum": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "lease": {
                    "type": "string",
                    "maxLength": 64
                  },
                  "sent": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "lease",
                  "sent"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Resultado guardado"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "409": {
            "$ref": "#/components/responses/409"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "SessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "session",
        "description": "Cookie devuelta al iniciar sesión."
      },
      "Bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      },
      "Health": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "storage": {
            "type": "string"
          },
          "architecture": {
            "type": "string"
          }
        },
        "required": [
          "service",
          "status"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "authenticated": {
            "type": "boolean"
          },
          "required": {
            "type": "boolean"
          },
          "account": {
            "type": "object",
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 1
              },
              "email": {
                "type": "string",
                "format": "email",
                "example": "propietario@example.test"
              },
              "role": {
                "type": "string",
                "enum": [
                  "owner",
                  "technician"
                ],
                "default": "owner"
              }
            }
          }
        },
        "required": [
          "authenticated",
          "required"
        ]
      },
      "Registration": {
        "type": "object",
        "properties": {
          "registrationId": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "registrationId",
          "message"
        ]
      },
      "Device": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "example": "CT-001"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "example": "Nombre de prueba"
          }
        },
        "required": [
          "deviceId"
        ]
      },
      "DeviceCreated": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "example": "CT-001"
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "example": "Nombre de prueba"
          },
          "gatewayToken": {
            "type": "string"
          }
        },
        "required": [
          "deviceId",
          "name",
          "gatewayToken"
        ]
      },
      "PolicyChanges": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "channels": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "tempInterior",
                "tempCondensador",
                "tempSuccion",
                "presionAlta",
                "presionBaja"
              ]
            }
          },
          "schedule": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "day": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 6,
                  "description": "0 para lunes y 6 para domingo"
                },
                "start": {
                  "type": "string",
                  "example": "07:30"
                },
                "end": {
                  "type": "string",
                  "example": "19:30"
                }
              },
              "required": [
                "day",
                "start",
                "end"
              ]
            }
          },
          "limits": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
      "Policy": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PolicyChanges"
          },
          {
            "type": "object",
            "properties": {
              "timezone": {
                "type": "string",
                "example": "UTC"
              },
              "samplingActive": {
                "type": "boolean"
              },
              "revision": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64
              }
            },
            "required": [
              "timezone",
              "samplingActive"
            ]
          }
        ]
      },
      "TelemetryInput": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "example": "CT-001"
          },
          "estado": {
            "type": "string",
            "example": "NORMAL"
          },
          "diagnostico": {
            "type": "string",
            "example": "SIN_FALLAS"
          },
          "tempInterior": {
            "type": "number",
            "example": -18
          },
          "tempCondensador": {
            "type": "number",
            "example": 37
          },
          "tempSuccion": {
            "type": "number",
            "example": -22
          },
          "presionAlta": {
            "type": "number",
            "example": 65
          },
          "presionBaja": {
            "type": "number",
            "example": 28
          },
          "uptimeMs": {
            "type": "number",
            "nullable": true
          },
          "compresor": {
            "type": "number",
            "nullable": true
          },
          "fanSolicitado": {
            "type": "number",
            "nullable": true
          },
          "fanPWM": {
            "type": "number",
            "nullable": true
          },
          "fanRpm": {
            "type": "number",
            "nullable": true
          },
          "proteccionAlta": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer",
                "enum": [
                  0,
                  1
                ]
              }
            ]
          },
          "proteccionBaja": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer",
                "enum": [
                  0,
                  1
                ]
              }
            ]
          },
          "ordenParoCompresor": {
            "oneOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer",
                "enum": [
                  0,
                  1
                ]
              }
            ]
          }
        },
        "required": [
          "deviceId",
          "estado",
          "diagnostico"
        ]
      },
      "Telemetry": {
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "example": "CT-001"
          },
          "estado": {
            "type": "string",
            "example": "NORMAL"
          },
          "diagnostico": {
            "type": "string",
            "example": "SIN_FALLAS"
          },
          "tempInterior": {
            "type": "number",
            "example": -18
          },
          "tempCondensador": {
            "type": "number",
            "example": 37
          },
          "tempSuccion": {
            "type": "number",
            "example": -22
          },
          "presionAlta": {
            "type": "number",
            "example": 65
          },
          "presionBaja": {
            "type": "number",
            "example": 28
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "stored": {
            "type": "boolean"
          },
          "samplingActive": {
            "type": "boolean"
          },
          "uptimeMs": {
            "type": "number",
            "nullable": true
          },
          "compresor": {
            "type": "number",
            "nullable": true
          },
          "fanSolicitado": {
            "type": "number",
            "nullable": true
          },
          "fanPWM": {
            "type": "number",
            "nullable": true
          },
          "fanRpm": {
            "type": "number",
            "nullable": true
          },
          "proteccionAlta": {
            "type": "boolean",
            "nullable": true
          },
          "proteccionBaja": {
            "type": "boolean",
            "nullable": true
          },
          "ordenParoCompresor": {
            "type": "boolean",
            "nullable": true
          }
        }
      },
      "TelemetryReceipt": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string"
          },
          "deviceId": {
            "type": "string",
            "example": "CT-001"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "integer",
            "nullable": true
          },
          "stored": {
            "type": "boolean"
          },
          "samplingActive": {
            "type": "boolean"
          }
        }
      },
      "Alert": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "type": {
            "type": "string"
          },
          "severity": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "openedAt": {
            "type": "string"
          },
          "resolvedAt": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "Technician": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "name": {
            "type": "string",
            "maxLength": 100,
            "example": "Nombre de prueba"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "propietario@example.test"
          },
          "phone": {
            "type": "string"
          }
        }
      },
      "Review": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "alertId": {
            "type": "integer",
            "minimum": 1
          },
          "technicianId": {
            "type": "integer",
            "minimum": 1
          },
          "deviceId": {
            "type": "string",
            "example": "CT-001"
          },
          "description": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Mail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "lease": {
            "type": "string"
          },
          "recipient": {
            "type": "string",
            "format": "email",
            "example": "propietario@example.test"
          },
          "subject": {
            "type": "string"
          },
          "body": {
            "type": "string"
          }
        }
      },
      "CapturePolicyStatus": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Policy"
          },
          {
            "type": "object",
            "properties": {
              "captureAck": {
                "type": "object",
                "nullable": true,
                "properties": {
                  "revision": {
                    "type": "string",
                    "minLength": 64,
                    "maxLength": 64
                  },
                  "applied": {
                    "type": "boolean"
                  },
                  "acknowledgedAt": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "revision",
                  "applied",
                  "acknowledgedAt"
                ]
              },
              "captureAckCurrent": {
                "type": "boolean"
              }
            },
            "required": [
              "captureAck",
              "captureAckCurrent"
            ]
          }
        ]
      }
    },
    "responses": {
      "400": {
        "description": "Solicitud inválida",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "401": {
        "description": "Falta una sesión o credencial válida",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "403": {
        "description": "El rol no puede realizar la operación",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "404": {
        "description": "Recurso no disponible",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "409": {
        "description": "Conflicto con el estado actual",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "415": {
        "description": "Se requiere application/json",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "429": {
        "description": "Demasiados intentos",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "503": {
        "description": "Función sin configurar",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
