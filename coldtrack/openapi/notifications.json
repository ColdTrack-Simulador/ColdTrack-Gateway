{
  "paths": {
    "/api/devices/{device_id}/notification-preferences": {
      "get": {
        "operationId": "getNotificationPreferences",
        "tags": [
          "Equipos"
        ],
        "summary": "Consultar preferencias de correo",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "CT-001"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Preferencias del equipo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationPreferences"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      },
      "put": {
        "operationId": "setNotificationPreferences",
        "tags": [
          "Equipos"
        ],
        "summary": "Reemplazar preferencias de correo",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "parameters": [
          {
            "name": "device_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "example": "CT-001"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationPreferences"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Preferencias actualizadas",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationPreferences"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NotificationPreferences": {
        "type": "object",
        "properties": {
          "emailEnabled": {
            "type": "boolean",
            "default": true
          },
          "mutedCodes": {
            "type": "array",
            "items": {
              "type": "string",
              "example": "tempInterior:max"
            }
          }
        },
        "required": [
          "emailEnabled",
          "mutedCodes"
        ]
      }
    }
  }
}
