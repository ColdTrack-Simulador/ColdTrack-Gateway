{
  "paths": {
    "/api/profile": {
      "get": {
        "operationId": "getProfile",
        "tags": [
          "Cuenta"
        ],
        "summary": "Consultar perfil propio",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "responses": {
          "200": {
            "description": "Perfil",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      },
      "patch": {
        "operationId": "updateProfile",
        "tags": [
          "Cuenta"
        ],
        "summary": "Actualizar nombre o teléfono",
        "security": [
          {
            "SessionCookie": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "example": "Nombre de prueba"
                  },
                  "phone": {
                    "type": "string",
                    "maxLength": 40
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Perfil actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      }
    },
    "/api/password-reset": {
      "post": {
        "operationId": "requestPasswordReset",
        "tags": [
          "Cuenta"
        ],
        "summary": "Solicitar código de recuperación",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "owner@example.test"
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Respuesta genérica",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "message"
                  ]
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      }
    },
    "/api/password-reset/confirm": {
      "post": {
        "operationId": "confirmPasswordReset",
        "tags": [
          "Cuenta"
        ],
        "summary": "Cambiar contraseña con código de recuperación",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email",
                    "example": "owner@example.test"
                  },
                  "code": {
                    "type": "string",
                    "pattern": "^[0-9]{6}$",
                    "example": "123456"
                  },
                  "password": {
                    "type": "string",
                    "format": "password",
                    "minLength": 12,
                    "maxLength": 256,
                    "example": "clave-local-larga"
                  }
                },
                "required": [
                  "email",
                  "code",
                  "password"
                ]
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Contraseña actualizada y sesiones previas invalidadas"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "429": {
            "$ref": "#/components/responses/429"
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Profile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "owner@example.test"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "example": "Nombre de prueba"
          },
          "phone": {
            "type": "string",
            "maxLength": 40
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "technician"
            ]
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "phone",
          "role"
        ]
      }
    }
  }
}
